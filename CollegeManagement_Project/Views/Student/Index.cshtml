@model IEnumerable<Student>
@{ ViewData["Title"] = "Студенты"; }
<div class="page-heading"><div><p class="eyebrow">УЧЕБНЫЙ СОСТАВ</p><h1>Студенты</h1></div><a class="button" asp-action="Create">Добавить студента</a></div>
<div class="table-wrap"><table><thead><tr><th>ID</th><th>Имя</th><th>Фамилия</th><th>Возраст</th><th>Группа</th><th></th></tr></thead><tbody>
@foreach (var s in Model) { <tr><td>@s.StudentId</td><td>@s.Name</td><td>@s.Surname</td><td>@s.StudentAge</td><td><span class="tag">@s.Group</span></td><td><a class="danger-link" asp-action="Delete" asp-route-id="@s.StudentId">Удалить</a></td></tr> }
</tbody></table></div>
